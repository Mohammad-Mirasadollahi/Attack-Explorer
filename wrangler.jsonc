{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "attack-explorer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Paid Workers: raise CPU ceiling so cold paths / Markdown API stay under Error 1102.
  // Free plan remains capped by Cloudflare; SSG cache interception is the primary fix.
  "limits": {
    "cpu_ms": 60000
  }
}
