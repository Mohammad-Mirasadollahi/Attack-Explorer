# Canonical public origin (no trailing slash). Used for metadata, sitemap, robots, OG, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.attackexplorer.com

# Legacy alias still accepted by resolveSiteUrl(). Must be a real absolute URL — never MY_APP_URL.
APP_URL=https://www.attackexplorer.com

# Optional: Gemini API key for Search Grounding in ThreatIntelCard
GEMINI_API_KEY=
